{
  "name": "a8csp-ai-canvas",
  "version": "2.0.0",
  "description": "Lets Claude Design, or any MCP client, build pages on this site as a single Custom HTML block, and adds the page templates those pages render on.",
  "author": {
    "name": "A8C Special Projects",
    "url": "https://specialprojects.automattic.com/"
  },
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress"
  ],
  "homepage": "https://github.com/a8cteam51/a8csp-ai-canvas",
  "repository": "https://github.com/a8cteam51/a8csp-ai-canvas",
  "bugs": "https://github.com/a8cteam51/a8csp-ai-canvas/issues",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "devDependencies": {
    "@a8csp/configs": "github:a8cteam51/a8csp-configs#semver:^1",
    "@playwright/test": "^1.61.1",
    "@wordpress/a11y": "^4.57.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/block-editor": "^18.1.0",
    "@wordpress/browserslist-config": "^6.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/compose": "^8.9.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/dom": "^4.56.0",
    "@wordpress/dom-ready": "^4.55.0",
    "@wordpress/e2e-test-utils-playwright": "^3.0.0",
    "@wordpress/editor": "^15.2.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/hooks": "^4.56.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/icons": "^18.0.0",
    "@wordpress/keycodes": "^4.56.0",
    "@wordpress/notices": "^5.56.0",
    "@wordpress/plugins": "^7.56.0",
    "@wordpress/postcss-plugins-preset": "^5.57.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/url": "^4.56.0",
    "npm-run-all": "^4.1.5"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "packages-install": "npm install",
    "packages-update": "npm update",
    "packages-update:wp": "wp-scripts packages-update --dist-tag=wp-7.1",
    "build": "NODE_ENV=production npm-run-all --sequential build:**",
    "build:assets:scripts": "wp-scripts build assets/js/src/*.js --output-path=assets/js/build",
    "start": "npm-run-all --parallel start:**",
    "start:assets:scripts": "wp-scripts start assets/js/src/*.js --output-path=assets/js/build",
    "format": "npm-run-all --sequential format:**",
    "format:scripts": "wp-scripts format assets/js --no-error-on-unmatched-pattern",
    "format:styles": "npm run lint:styles -- --fix",
    "lint": "npm-run-all --sequential lint:**",
    "lint:scripts": "wp-scripts lint-js assets/js eslint.config.mjs postcss.config.js stylelint.config.js playwright.config.js tests/EndToEnd tests/JavaScript --no-error-on-unmatched-pattern",
    "lint:styles": "wp-scripts lint-style 'assets/css/**/*.{css,scss}' --allow-empty-input",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:readme-md": "wp-scripts lint-md-docs README.md",
    "wp-env:start": "wp-env start",
    "wp-env:update": "wp-env start --update",
    "wp-env:stop": "wp-env stop",
    "wp-env:destroy": "wp-env destroy",
    "wp-env:tests:start": "wp-env --config .wp-env.tests.json start",
    "wp-env:tests:stop": "wp-env --config .wp-env.tests.json stop",
    "wp-env:tests:destroy": "wp-env --config .wp-env.tests.json destroy",
    "wp-env:belowfloor:start": "wp-env --config .wp-env.belowfloor.json start",
    "wp-env:belowfloor:stop": "wp-env --config .wp-env.belowfloor.json stop",
    "wp-env:belowfloor:destroy": "wp-env --config .wp-env.belowfloor.json destroy",
    "wp-env:multisite:start": "wp-env --config .wp-env.multisite.json start",
    "wp-env:multisite:stop": "wp-env --config .wp-env.multisite.json stop",
    "wp-env:multisite:destroy": "wp-env --config .wp-env.multisite.json destroy",
    "audit": "composer audit --locked --abandoned=report && npm audit --audit-level=high --omit=dev",
    "audit:fix": "npm audit fix",
    "check:engines": "wp-scripts check-engines",
    "check:licenses": "wp-scripts check-licenses",
    "test:unit": "wp-scripts test-unit-js",
    "test:integration": "wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/plugins/a8csp-ai-canvas vendor/bin/phpunit --testsuite=Integration",
    "test:requirements": "wp-env --config .wp-env.belowfloor.json run cli --env-cwd=wp-content/plugins/a8csp-ai-canvas vendor/bin/phpunit --testsuite=Requirements",
    "test:multisite": "wp-env --config .wp-env.multisite.json run cli --env-cwd=wp-content/plugins/a8csp-ai-canvas vendor/bin/phpunit --testsuite=Multisite",
    "test:e2e": "playwright test"
  }
}
