{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.5",
  "port": 8890,
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/a8csp-plugin-template": ".",
    "wp-content/plugins/woocommerce": "./vendor/wp-plugin/woocommerce"
  },
  "lifecycleScripts": {
    "afterStart": "./node_modules/.bin/wp-env --config .wp-env.tests.json run cli wp plugin activate woocommerce a8csp-plugin-template"
  },
  "config": {
    "WP_DEBUG_DISPLAY": false,
    "WP_DEBUG_LOG": true
  }
}
